# ====================================================================
# Smart AI Mentor–Mentee Management System - Environment Configuration
# ====================================================================

PORT=5000
NODE_ENV=development

# JWT Secret for session authentication
JWT_SECRET=smart-ai-mentor-secret-key-development-2026

# MySQL Database Configuration
# NOTE: If MySQL credentials are not provided or connection fails,
# the backend automatically falls back to an atomic, persistent JSON store
# (backend/data/mentor_db.json) with pre-seeded demo records for zero-friction testing.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mentor_system_db
